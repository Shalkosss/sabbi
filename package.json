{
  "name": "sabbi",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma Sabbi de plan patrimonial",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:paquetes && npm run build --workspaces --if-present",
    "dev": "npm run build:paquetes && npm run dev --workspace apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "build:paquetes": "tsc --build",
    "migrar": "node --env-file-if-exists=.env.local tools/migrar.mjs",
    "revisar-deck": "node tools/revisar-deck.mjs",
    "exportar-benchmark": "npm run build:paquetes && node tools/exportar-benchmark.mjs",
    "revisar-catalogo": "node tools/revisar-catalogo.mjs \"reference/BD_Productos (1).xlsx\"",
    "importar-catalogo": "node --env-file-if-exists=.env.local tools/importar-catalogo.mjs \"reference/BD_Productos (1).xlsx\"",
    "revisar-retornos": "npm run build:paquetes && node tools/revisar-retornos.mjs",
    "importar-retornos": "npm run build:paquetes && node --env-file-if-exists=.env.local tools/importar-retornos.mjs",
    "deck-de-muestra": "npm run build:paquetes && node tools/deck-de-muestra.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "pg": "^8.23.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
